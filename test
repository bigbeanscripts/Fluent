local function HookWindow(Window)
	if not Window or type(Window) ~= "table" then return Window end

	local OriginalAddTab = Window.AddTab
	local CurrentTabIndex = 0
	local SidebarItemOrder = 0
	local ActiveTabCategory = nil

	local function InternalAddTabSection(title)
		if not title or title == "" then return end
		title = tostring(title):upper()
		SidebarItemOrder += 1

		local TabHolder = Window.TabHolder or (Window.Root and Window.Root:FindFirstChild("TabHolder", true))
		if not TabHolder then return end

		local SectionFrame = Instance.new("Frame")
		SectionFrame.Name = "TabSectionHeader_" .. title
		SectionFrame.Parent = TabHolder
		SectionFrame.BackgroundTransparency = 1
		SectionFrame.Size = UDim2.new(1, 0, 0, 24)
		SectionFrame.LayoutOrder = SidebarItemOrder
		SectionFrame.ZIndex = 4

		local SectionLabel = Instance.new("TextLabel")
		SectionLabel.Name = "SectionTitle"
		SectionLabel.Parent = SectionFrame
		SectionLabel.BackgroundTransparency = 1
		SectionLabel.Position = UDim2.new(0, 10, 0, 4)
		SectionLabel.Size = UDim2.new(1, -20, 1, -4)
		SectionLabel.Font = Enum.Font.GothamBold
		SectionLabel.Text = title
		SectionLabel.TextColor3 = SubColor
		SectionLabel.TextSize = 11
		SectionLabel.TextXAlignment = Enum.TextXAlignment.Left
		SectionLabel.ZIndex = 4

		table.insert(TabSectionLabels, SectionLabel)
		ActiveTabCategory = title
		return {
			Title = title,
			Frame = SectionFrame,
			Section = title
		}
	end

	local function GlobalAddTabSection(selfOrTitle, maybeTitle)
		local title = maybeTitle
		if title == nil and type(selfOrTitle) == "string" then
			title = selfOrTitle
		end
		return InternalAddTabSection(title)
	end

	local function AttachTabSectionMethods(target)
		if type(target) ~= "table" then return end
		rawset(target, "AddTabSection", GlobalAddTabSection)
		rawset(target, "CreateTabSection", GlobalAddTabSection)
		rawset(target, "TabSection", GlobalAddTabSection)
		rawset(target, "AddSection", GlobalAddTabSection)

		local mt = getmetatable(target)
		if mt then
			if type(mt.__index) == "table" then
				rawset(mt.__index, "AddTabSection", GlobalAddTabSection)
				rawset(mt.__index, "CreateTabSection", GlobalAddTabSection)
				rawset(mt.__index, "TabSection", GlobalAddTabSection)
				rawset(mt.__index, "AddSection", GlobalAddTabSection)
			end
			rawset(mt, "AddTabSection", GlobalAddTabSection)
			rawset(mt, "AddSection", GlobalAddTabSection)
			rawset(mt, "TabSection", GlobalAddTabSection)
			rawset(mt, "CreateTabSection", GlobalAddTabSection)
		end
	end

	AttachTabSectionMethods(Window)
	AttachTabSectionMethods(Library)
	if type(Library.Window) == "table" then
		AttachTabSectionMethods(Library.Window)
	end

	Window.AddTab = function(self, tabOptions)
		CurrentTabIndex += 1
		local ThisTabIndex = CurrentTabIndex

		local requestedSection = tabOptions.Section or tabOptions.Category or tabOptions.TabSection
		if requestedSection and tostring(requestedSection):upper() ~= ActiveTabCategory then
			InternalAddTabSection(requestedSection)
		end

		local TabHolder = Window.TabHolder or (Window.Root and Window.Root:FindFirstChild("TabHolder", true))
		local preChildren = {}
		if TabHolder then
			for _, c in ipairs(TabHolder:GetChildren()) do
				preChildren[c] = true
			end
		end

		local Tab = OriginalAddTab(self, tabOptions)

		SidebarItemOrder += 1

		if TabHolder then
			local newButton = nil
			for _, c in ipairs(TabHolder:GetChildren()) do
				if not preChildren[c] and c:IsA("GuiButton") then
					newButton = c
					break
				end
			end
			if not newButton then
				for _, c in ipairs(TabHolder:GetChildren()) do
					if c:IsA("GuiButton") and not c.Name:find("TabSectionHeader") and c.Name ~= "PinnedSearchBar" then
						local lbl = c:FindFirstChildOfClass("TextLabel")
						if lbl and lbl.Text == tabOptions.Title then
							newButton = c
							break
						end
					end
				end
			end

			if newButton then
				newButton.LayoutOrder = SidebarItemOrder
				newButton.Size = UDim2.new(1, 0, 0, 32)
				newButton.BackgroundColor3 = Color3.fromRGB(26, 29, 38)
				newButton.BackgroundTransparency = 0.28

				local btnCorner = newButton:FindFirstChildOfClass("UICorner") or Instance.new("UICorner", newButton)
				btnCorner.CornerRadius = UDim.new(0, 6)

				local btnStroke = newButton:FindFirstChild("CardStroke") or Instance.new("UIStroke", newButton)
				btnStroke.Name = "CardStroke"
				btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				btnStroke.Thickness = 1
				btnStroke.Transparency = 0.88
				btnStroke.Color = Color3.fromRGB(255, 255, 255)

				local rec = { Button = newButton, Stroke = btnStroke, Index = ThisTabIndex }
				table.insert(TabButtonRecords, rec)

				table.insert(ActiveConnections, newButton.MouseEnter:Connect(function()
					if Window.SelectedTab ~= ThisTabIndex then
						TweenService:Create(newButton, TweenInfo.new(0.12), {BackgroundTransparency = 0.1}):Play()
						TweenService:Create(btnStroke, TweenInfo.new(0.12), {Transparency = 0.6}):Play()
					end
				end))

				table.insert(ActiveConnections, newButton.MouseLeave:Connect(function()
					local isSel = (Window.SelectedTab == ThisTabIndex)
					TweenService:Create(newButton, TweenInfo.new(0.12), {BackgroundTransparency = isSel and 0.05 or 0.28}):Play()
					TweenService:Create(btnStroke, TweenInfo.new(0.12), {Transparency = isSel and 0.45 or 0.88}):Play()
				end))
			end
		end

		local TabName = tabOptions.Title or "Unknown"
		local CurrentSection = TabName
		local CurrentCategory = ActiveTabCategory or ""

		local ctx = {
			TabName = TabName,
			TabIndex = ThisTabIndex,
			TabCategory = CurrentCategory,
			GetSection = function() return CurrentSection end,
			SetSection = function(v) CurrentSection = tostring(v or TabName) end
		}

		HookContainer(Tab, ctx)
		RecordElement(ctx, "Misc", TabName, Tab)

		return Tab
	end

	task.spawn(function()
		task.wait(0.1)
		pcall(function()
			local ScreenGui = Window.Root and Window.Root:FindFirstAncestorWhichIsA("ScreenGui")
			if ScreenGui then ScreenGui.IgnoreGuiInset = true end
		end)
	end)

	if Window.Root then
		local savedPos = Window.Root.Position
		local savedSize = Window.Root.Size
		local TopBar = Window.Root:FindFirstChild("TopBar") or Window.Root:FindFirstChild("TitleBar") or Window.Root:FindFirstChild("Header") or Window.Root:FindFirstChildWhichIsA("Frame")

		Window.Maximize = function(...)
			local args = {...}
			local selfObj = Window
			local targetState = nil

			if type(args[1]) == "table" and args[1].Root then
				selfObj = args[1]
				if type(args[2]) == "boolean" then targetState = args[2] end
			elseif type(args[1]) == "boolean" then
				targetState = args[1]
			end

			local shouldMaximize = (targetState ~= nil) and targetState or (not selfObj.Maximized)
			if not shouldMaximize then
				selfObj.Maximized = false
				TweenService:Create(selfObj.Root, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = savedPos,
					Size = savedSize
				}):Play()
			else
				savedPos = selfObj.Root.Position
				savedSize = selfObj.Root.Size
				selfObj.Maximized = true
				TweenService:Create(selfObj.Root, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = UDim2.new(0, 0, 0, 0),
					Size = UDim2.new(1, 0, 1, 0)
				}):Play()
			end
		end

		if TopBar then
			local isDraggingMax = false
			local dragOffsetRatio = 0.5

			table.insert(ActiveConnections, TopBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					local mouse = UserInputService:GetMouseLocation()
					local topBarAbs = TopBar.AbsolutePosition
					local topBarSize = TopBar.AbsoluteSize
					if mouse.X >= topBarAbs.X and mouse.X <= topBarAbs.X + topBarSize.X and mouse.Y >= topBarAbs.Y and mouse.Y <= topBarAbs.Y + topBarSize.Y then
						if Window.Maximized then
							isDraggingMax = true
							if topBarSize.X > 0 then
								dragOffsetRatio = math.clamp((mouse.X - topBarAbs.X) / topBarSize.X, 0.1, 0.9)
							else
								dragOffsetRatio = 0.5
							end
						end
					end
				end
			end))

			table.insert(ActiveConnections, UserInputService.InputChanged:Connect(function(input)
				if isDraggingMax and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local mouse = UserInputService:GetMouseLocation()
					isDraggingMax = false
					Window.Maximized = false

					local restoredW = savedSize.X.Offset > 100 and savedSize.X.Offset or 580
					local restoredH = savedSize.Y.Offset > 100 and savedSize.Y.Offset or 460
					local newX = math.clamp(mouse.X - (restoredW * dragOffsetRatio), 0, math.max(0, workspace.CurrentCamera.ViewportSize.X - restoredW))
					local newY = math.clamp(mouse.Y - 18, 0, math.max(0, workspace.CurrentCamera.ViewportSize.Y - restoredH))

					Window.Root.Size = UDim2.fromOffset(restoredW, restoredH)
					Window.Root.Position = UDim2.fromOffset(newX, newY)
					savedPos = Window.Root.Position
				end
			end))

			table.insert(ActiveConnections, UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isDraggingMax = false
				end
			end))
		end
	end

	task.spawn(function()
		task.wait(0.1)
		CustomizeLibrary(Window)
	end)

	return Window
end

local function GlobalFallbackAddSection(selfOrTitle, maybeTitle)
	local title = maybeTitle
	if title == nil and type(selfOrTitle) == "string" then
		title = selfOrTitle
	end
	if Library.CurrentWindow and Library.CurrentWindow.AddTabSection then
		return Library.CurrentWindow:AddTabSection(title)
	end
end

Library.AddTabSection = GlobalFallbackAddSection
Library.CreateTabSection = GlobalFallbackAddSection
Library.TabSection = GlobalFallbackAddSection
Library.AddSection = GlobalFallbackAddSection

if type(Library.Window) == "table" then
	Library.Window.AddTabSection = GlobalFallbackAddSection
	Library.Window.CreateTabSection = GlobalFallbackAddSection
	Library.Window.TabSection = GlobalFallbackAddSection
	Library.Window.AddSection = GlobalFallbackAddSection
end

Library.CreateWindow = function(self, options)
	local Window = HookWindow(OriginalCreateWindow(self, options))
	Library.CurrentWindow = Window
	return Window
end

if OriginalWindowCtor then
	Library.Window = function(self, options)
		local Window = HookWindow(OriginalWindowCtor(self, options))
		Library.CurrentWindow = Window
		return Window
	end
end

local toggleGui = Instance.new("ScreenGui")
toggleGui.Name = "DuckyToggleGui"
toggleGui.ResetOnSpawn = false
toggleGui.DisplayOrder = 100
toggleGui.Parent = (RunService:IsStudio() and LocalPlayer:WaitForChild("PlayerGui") or CoreGui)

local toggleBtn = Instance.new("ImageButton")
local normalSize = UDim2.new(0, 150, 0, 150)
local pressedSize = UDim2.new(0, 135, 0, 135)

toggleBtn.Size = normalSize
toggleBtn.AnchorPoint = Vector2.new(1, 0)
toggleBtn.Position = UDim2.new(1, -10, 0, 10) 
toggleBtn.BackgroundTransparency = 1
toggleBtn.Image = "rbxassetid://116073591672187"
toggleBtn.Parent = toggleGui
toggleBtn.Active = true

local dragging, dragInput, mousePos, framePos

table.insert(ActiveConnections, toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        mousePos = input.Position
        framePos = toggleBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end))

table.insert(ActiveConnections, toggleBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end))

table.insert(ActiveConnections, UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - mousePos
        toggleBtn.Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
    end
end))

table.insert(ActiveConnections, toggleBtn.MouseButton1Down:Connect(function()
    TweenService:Create(toggleBtn, TweenInfo.new(0.1), {Size = pressedSize, ImageColor3 = Color3.fromRGB(200, 200, 255)}):Play()
end))

table.insert(ActiveConnections, toggleBtn.MouseButton1Up:Connect(function()
    TweenService:Create(toggleBtn, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Size = normalSize, ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
end))

table.insert(ActiveConnections, toggleBtn.Activated:Connect(function()
    if Library.CurrentWindow then Library.CurrentWindow:Minimize() end
end))

table.insert(ActiveConnections, LocalPlayer.OnTeleport:Connect(function()
    DisconnectAll()
    if toggleGui and toggleGui.Parent then toggleGui:Destroy() end
end))

return Library
