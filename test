	TabHolder.Position = UDim2.new(0, 0, 0, 0)
	TabHolder.Size = UDim2.new(1, 0, 1, 0)
	TabHolder.ClipsDescendants = true
	TabHolder.ScrollingDirection = Enum.ScrollingDirection.Y

	local PAD_TOP, PAD_BOTTOM = 2, 2
	local ListPadding = TabHolder:FindFirstChildOfClass("UIPadding") or Create("UIPadding", {Parent = TabHolder})
	ListPadding.PaddingTop = UDim.new(0, PAD_TOP)
	ListPadding.PaddingBottom = UDim.new(0, PAD_BOTTOM)

	local TabLayout = TabHolder:FindFirstChildOfClass("UIListLayout")
	local function FixTabCanvas()
		if not TabHolder.Parent or not TabLayout then return end
		TabHolder.AutomaticCanvasSize = Enum.AutomaticSize.None
		TabHolder.CanvasSize = UDim2.fromOffset(0, TabLayout.AbsoluteContentSize.Y + PAD_TOP + PAD_BOTTOM)
	end
	local canvasQueued = false
	local function QueueFixCanvas()
		if canvasQueued then return end
		canvasQueued = true
		task.defer(function()
			canvasQueued = false
			FixTabCanvas()
		end)
	end
	if TabLayout then
		TabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(QueueFixCanvas)
		TabHolder:GetPropertyChangedSignal("CanvasSize"):Connect(function()
			local want = TabLayout.AbsoluteContentSize.Y + PAD_TOP + PAD_BOTTOM
			if math.abs(TabHolder.CanvasSize.Y.Offset - want) > 0.5 or TabHolder.CanvasSize.Y.Scale ~= 0 then
				QueueFixCanvas()
			end
		end)
		FixTabCanvas()
	end

