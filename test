local function HookWindow(Window)
	if not Window or type(Window) ~= "table" or Window.__SearchHooked then return Window end
	Window.__SearchHooked = true

	local OriginalAddTab = Window.AddTab
	local CurrentTabIndex = 0

	Window.AddTab = function(self, tabOptions)
		CurrentTabIndex += 1
		local ThisTabIndex = CurrentTabIndex

		local Tab = OriginalAddTab(self, tabOptions)

		local TabName = tabOptions.Title or "Unknown"
		local CurrentSection = TabName

		local ctx = {
			TabName = TabName,
			TabIndex = ThisTabIndex,
			GetSection = function() return CurrentSection end,
			SetSection = function(v) CurrentSection = tostring(v or TabName) end
		}

		HookContainer(Tab, ctx)
		RecordElement(ctx, "Misc", TabName, Tab)

		return Tab
	end

	task.spawn(function()
		task.wait(0.1)
		pcall(function()
			local ScreenGui = Window.Root and Window.Root:FindFirstAncestorWhichIsA("ScreenGui")
			if ScreenGui then
				ScreenGui.IgnoreGuiInset = true
			end
		end)
	end)

	if Window.Root then
		local savedPos = Window.Root.Position
		local savedSize = Window.Root.Size

		Window.Maximize = function(...)
			local args = {...}
			local selfObj = Window
			local targetState = nil

			if type(args[1]) == "table" and args[1].Root then
				selfObj = args[1]
				if type(args[2]) == "boolean" then
					targetState = args[2]
				end
			elseif type(args[1]) == "boolean" then
				targetState = args[1]
			end

			local shouldMaximize
			if targetState ~= nil then
				shouldMaximize = targetState
			else
				shouldMaximize = not selfObj.Maximized
			end

			if not shouldMaximize then
				selfObj.Maximized = false
				TweenService:Create(selfObj.Root, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = savedPos,
					Size = savedSize
				}):Play()
			else
				savedPos = selfObj.Root.Position
				savedSize = selfObj.Root.Size
				selfObj.Maximized = true
				TweenService:Create(selfObj.Root, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = UDim2.new(0, 0, 0, 0),
					Size = UDim2.new(1, 0, 1, 0)
				}):Play()
			end
		end
	end

	task.spawn(function()
		task.wait(0.1)
		CustomizeLibrary(Window)
	end)

	return Window
end

Library.CreateWindow = function(self, options)
	local Window = HookWindow(OriginalCreateWindow(self, options))
	Library.CurrentWindow = Window
	return Window
end

if OriginalWindowCtor then
	Library.Window = function(self, options)
		local Window = HookWindow(OriginalWindowCtor(self, options))
		Library.CurrentWindow = Window
		return Window
	end
end

