	local function UpdateDashboardTelemetry()
		local totalSeconds = math.floor(os.clock() - ScriptStartTime)
		local hours = math.floor(totalSeconds / 3600)
		local mins = math.floor((totalSeconds % 3600) / 60)
		local secs = totalSeconds % 60
		UptimeVal.Text = string.format("%02dh %02dm %02ds", hours, mins, secs)

		local ping = 0
		pcall(function()
			ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		PingVal.Text = tostring(ping) .. " ms"

		local mem = math.floor(collectgarbage("count") / 1024)
		MemoryVal.Text = tostring(mem) .. " MB"

		local friendsInServer = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				local ok, isFriend = pcall(function() return LocalPlayer:IsFriendsWith(p.UserId) end)
				if ok and isFriend then
					table.insert(friendsInServer, p.DisplayName)
				end
			end
		end

		if #friendsInServer > 0 then
			FriendsVal.Text = string.format("%d Friend(s): %s", #friendsInServer, table.concat(friendsInServer, ", "))
		else
			FriendsVal.Text = "None in this server"
		end
	end

	local function StopAllTelemetry()
		if fpsConn then
			fpsConn:Disconnect()
			fpsConn = nil
		end
		if dashboardLoopThread then
			task.cancel(dashboardLoopThread)
			dashboardLoopThread = nil
		end
	end

	local function OpenDashboard()
		DashboardOverlay.Visible = true
		TweenService:Create(DashboardOverlay, TweenInfo.new(0.2), {BackgroundTransparency = 0.55}):Play()
		DashboardCard.Size = UDim2.fromOffset(440, 296)
		TweenService:Create(DashboardCard, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(460, 316)}):Play()

		StopAllTelemetry()

		dashboardLoopThread = task.spawn(function()
			task.wait(1)
			if not DashboardOverlay.Visible then return end

			local frameCount = 0
			local lastFpsTick = os.clock()

			if fpsConn then fpsConn:Disconnect() end
			fpsConn = RunService.RenderStepped:Connect(function()
				frameCount += 1
				local now = os.clock()
				if now - lastFpsTick >= 1 then
					FpsVal.Text = tostring(math.floor(frameCount / (now - lastFpsTick))) .. " FPS"
					frameCount = 0
					lastFpsTick = now
				end
			end)

			UpdateDashboardTelemetry()

			while DashboardOverlay.Visible do
				task.wait(1)
				if DashboardOverlay.Visible then
					UpdateDashboardTelemetry()
				end
			end
		end)
	end

	local function CloseDashboard()
		StopAllTelemetry()
		TweenService:Create(DashboardOverlay, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
		TweenService:Create(DashboardCard, TweenInfo.new(0.15), {Size = UDim2.fromOffset(440, 296)}):Play()
