	local function UpdateDashboardTelemetry()
		local totalSeconds = math.floor(os.clock() - ScriptStartTime)
		local hours = math.floor(totalSeconds / 3600)
		local mins = math.floor((totalSeconds % 3600) / 60)
		local secs = totalSeconds % 60
		UptimeVal.Text = string.format("%02dh %02dm %02ds", hours, mins, secs)

		local ping = 0
		pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
		PingVal.Text = tostring(ping) .. " ms"

		local mem = math.floor(collectgarbage("count") / 1024)
		MemoryVal.Text = tostring(mem) .. " MB"

		local friendsInServer = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				local ok, isFriend = pcall(function() return LocalPlayer:IsFriendsWith(p.UserId) end)
				if ok and isFriend then table.insert(friendsInServer, p.DisplayName) end
			end
		end

		FriendsVal.Text = (#friendsInServer > 0) and string.format("%d Friend(s): %s", #friendsInServer, table.concat(friendsInServer, ", ")) or "None in this server"
	end

