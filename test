				arrowIcon.Image = "rbxassetid://10709790948"
				arrowIcon.ImageColor3 = TargetTextColor
				arrowIcon.Size = UDim2.fromOffset(14, 14)
				arrowIcon.AnchorPoint = Vector2.new(1, 0.5)
				arrowIcon.Position = UDim2.new(1, -6, 0.5, 0)
				arrowIcon.Rotation = isExpanded and 180 or 0
				arrowIcon.ZIndex = 20
				arrowIcon.Parent = titleLabel

				local triggerBtn = Instance.new("TextButton")
				triggerBtn.Name = "CollapsibleTrigger"
				triggerBtn.Size = UDim2.fromScale(1, 1)
				triggerBtn.Position = UDim2.new(0, 0, 0, 0)
				triggerBtn.BackgroundTransparency = 1
				triggerBtn.Text = ""
				triggerBtn.ZIndex = 25
				triggerBtn.Parent = titleLabel

				triggerBtn.MouseEnter:Connect(function()
					local isDark = ((TargetTextColor.R + TargetTextColor.G + TargetTextColor.B) / 3) > 0.5
					local hoverColor = isDark and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
					TweenService:Create(titleLabel, TweenInfo.new(0.15), {TextColor3 = hoverColor}):Play()
					TweenService:Create(arrowIcon, TweenInfo.new(0.15), {ImageColor3 = hoverColor}):Play()
				end)

				triggerBtn.MouseLeave:Connect(function()
					TweenService:Create(titleLabel, TweenInfo.new(0.15), {TextColor3 = TargetTextColor}):Play()
					TweenService:Create(arrowIcon, TweenInfo.new(0.15), {ImageColor3 = TargetTextColor}):Play()
				end)

				triggerBtn.MouseButton1Click:Connect(function()
					SetExpanded(not isExpanded)
				end)
			end

			local sub = {}
			setmetatable(sub, { __index = sec })

			local methods = {"AddToggle", "AddDropdown", "AddButton", "AddParagraph", "AddSlider", "AddInput", "AddKeybind"}
			for _, m in ipairs(methods) do
				sub[m] = function(_, ...)
					local innerArgs = {...}
					local countBefore = scrollFrame and #scrollFrame:GetChildren() or 0
					local success, el = pcall(function()
						return self[m](self, unpack(innerArgs))
					end)
					if not success then return nil end

					if scrollFrame then
						local newChildren = scrollFrame:GetChildren()
						for i = countBefore + 1, #newChildren do
							local itemFrame = newChildren[i]
							if itemFrame:IsA("GuiObject") and itemFrame ~= secFrame then
								itemFrame.Visible = isExpanded
								table.insert(childFrames, itemFrame)
								SectionExpanders[itemFrame] = expandAction
							end
						end
					end

					return el
				end
			end

			sub.Toggle = sub.AddToggle
			sub.Dropdown = sub.AddDropdown
			sub.Button = sub.AddButton
			sub.Paragraph = sub.AddParagraph
			sub.Slider = sub.AddSlider
			sub.Input = sub.AddInput
			sub.Keybind = sub.AddKeybind

			sub.CreateToggle = sub.AddToggle
			sub.CreateDropdown = sub.AddDropdown
			sub.CreateButton = sub.AddButton
			sub.CreateParagraph = sub.AddParagraph
			sub.CreateSlider = sub.AddSlider
			sub.CreateInput = sub.AddInput
			sub.CreateKeybind = sub.AddKeybind

			return sub
		end

		container.Section = function(self, ...) return self:AddSection(...) end
		container.CreateSection = function(self, ...) return self:AddSection(...) end
		container.AddCollapsible = function(self, ...) return self:AddSection(...) end
		container.Collapsible = function(self, ...) return self:AddSection(...) end
