	end

	if container.AddSlider and not container.__HookAddSlider then
		container.__HookAddSlider = true
		local Old = container.AddSlider
		container.AddSlider = function(self, arg1, arg2, ...)
			local el = Old(self, arg1, arg2, ...)
			local title = GetTitle(arg1, arg2)
			RecordElement(ctx, "Slider", title, el)
			return el
		end
	end

	if container.AddInput and not container.__HookAddInput then
		container.__HookAddInput = true
		local Old = container.AddInput
		container.AddInput = function(self, arg1, arg2, ...)
			local el = Old(self, arg1, arg2, ...)
			local title = GetTitle(arg1, arg2)
			RecordElement(ctx, "Input", title, el)
			return el
		end
	end

	if container.AddKeybind and not container.__HookAddKeybind then
		container.__HookAddKeybind = true
		local Old = container.AddKeybind
		container.AddKeybind = function(self, arg1, arg2, ...)
			local el = Old(self, arg1, arg2, ...)
			local title = GetTitle(arg1, arg2)
			RecordElement(ctx, "Keybind", title, el)
			return el
		end
	end

	if container.AddSection and not container.__SectionHooked then
		container.__SectionHooked = true
		local OldAddSection = container.AddSection

		container.AddSection = function(self, arg1, arg2, ...)
			local title = GetTitle(arg1, arg2)
			local defaultExpanded = true
			if type(arg2) == "boolean" then
				defaultExpanded = arg2
			elseif type(arg1) == "table" and type(arg1.Default) == "boolean" then
				defaultExpanded = arg1.Default
			end

			local isExpanded = defaultExpanded
			local scrollFrame = GetScrollFrame(self)

			local sec = OldAddSection(self, tostring(title or "Section"))
			RecordElement(ctx, "Section", title, sec)

			local secFrame = nil
			if scrollFrame then
				local children = scrollFrame:GetChildren()
				secFrame = children[#children]
			end

			local childFrames = {}
			local titleLabel = secFrame and (secFrame:FindFirstChild("Title") or secFrame:FindFirstChildOfClass("TextLabel"))
			local originalColor = titleLabel and titleLabel.TextColor3 or Color3.fromRGB(240, 240, 240)
			local arrowIcon = nil

			local function SetExpanded(state)
				if isExpanded == state then return end
				isExpanded = state
				if arrowIcon then
					TweenService:Create(arrowIcon, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Rotation = isExpanded and 0 or 180
					}):Play()
				end
				for _, fr in ipairs(childFrames) do
					if fr and fr.Parent then
						fr.Visible = isExpanded
					end
				end
			end

			if titleLabel then
				titleLabel.AutomaticSize = Enum.AutomaticSize.Y
				titleLabel.Size = UDim2.new(1, 0, 0, 18)

				arrowIcon = Instance.new("ImageLabel")
				arrowIcon.Name = "CollapseArrow"
				arrowIcon.BackgroundTransparency = 1
				arrowIcon.Image = "rbxassetid://10709790948"
				arrowIcon.ImageColor3 = originalColor
				arrowIcon.Size = UDim2.fromOffset(14, 14)
				arrowIcon.AnchorPoint = Vector2.new(1, 0.5)
				arrowIcon.Position = UDim2.new(1, -6, 0.5, 0)
				arrowIcon.Rotation = isExpanded and 0 or 180
				arrowIcon.ZIndex = 20
				arrowIcon.Parent = titleLabel

				local triggerBtn = Instance.new("TextButton")
				triggerBtn.Name = "CollapsibleTrigger"
				triggerBtn.Size = UDim2.fromScale(1, 1)
				triggerBtn.Position = UDim2.new(0, 0, 0, 0)
				triggerBtn.BackgroundTransparency = 1
				triggerBtn.Text = ""
				triggerBtn.ZIndex = 25
				triggerBtn.Parent = titleLabel

				triggerBtn.MouseEnter:Connect(function()
					local hoverColor = Color3.fromRGB(255, 255, 255)
					TweenService:Create(titleLabel, TweenInfo.new(0.15), {TextColor3 = hoverColor}):Play()
					TweenService:Create(arrowIcon, TweenInfo.new(0.15), {ImageColor3 = hoverColor}):Play()
				end)

				triggerBtn.MouseLeave:Connect(function()
					TweenService:Create(titleLabel, TweenInfo.new(0.15), {TextColor3 = originalColor}):Play()
					TweenService:Create(arrowIcon, TweenInfo.new(0.15), {ImageColor3 = originalColor}):Play()
				end)

				triggerBtn.MouseButton1Click:Connect(function()
					SetExpanded(not isExpanded)
				end)
			end

			local sub = {}
			setmetatable(sub, { __index = sec })

			local methods = {"AddToggle", "AddDropdown", "AddButton", "AddParagraph", "AddSlider", "AddInput", "AddKeybind"}
			for _, m in ipairs(methods) do
				sub[m] = function(_, ...)
					local countBefore = scrollFrame and #scrollFrame:GetChildren() or 0
					local el = self[m](self, ...)

					if scrollFrame then
						local newChildren = scrollFrame:GetChildren()
						for i = countBefore + 1, #newChildren do
							local itemFrame = newChildren[i]
							if itemFrame:IsA("GuiObject") and itemFrame ~= secFrame then
								itemFrame.Visible = isExpanded
								table.insert(childFrames, itemFrame)
								SectionExpanders[itemFrame] = function()
									SetExpanded(true)
								end
							end
						end
					end

					return el
				end
			end

			sub.Toggle = sub.AddToggle
			sub.Dropdown = sub.AddDropdown
			sub.Button = sub.AddButton
			sub.Paragraph = sub.AddParagraph
			sub.Slider = sub.AddSlider
			sub.Input = sub.AddInput
			sub.Keybind = sub.AddKeybind

			return sub
		end

		container.Section = function(self, ...)
			return self:AddSection(...)
		end
		container.AddCollapsible = function(self, ...)
			return self:AddSection(...)
		end
		container.Collapsible = function(self, ...)
			return self:AddSection(...)
		end
	end

	if container.AddToggle then container.Toggle = container.AddToggle end
	if container.AddDropdown then container.Dropdown = container.AddDropdown end
	if container.AddButton then container.Button = container.AddButton end
	if container.AddParagraph then container.Paragraph = container.AddParagraph end
	if container.AddSlider then container.Slider = container.AddSlider end
	if container.AddInput then container.Input = container.AddInput end
	if container.AddKeybind then container.Keybind = container.AddKeybind end

	return container
end

