				arrowIcon.Image = "rbxassetid://10709790948"
				arrowIcon.ImageColor3 = TargetTextColor
				arrowIcon.Size = UDim2.fromOffset(14, 14)
				arrowIcon.AnchorPoint = Vector2.new(1, 0.5)
				arrowIcon.Position = UDim2.new(1, -6, 0.5, 0)
				arrowIcon.Rotation = isExpanded and 0 or 180
				arrowIcon.ZIndex = 20
				arrowIcon.Parent = titleLabel

				local triggerBtn = Instance.new("TextButton")
				triggerBtn.Name = "CollapsibleTrigger"
				triggerBtn.Size = UDim2.fromScale(1, 1)
				triggerBtn.Position = UDim2.new(0, 0, 0, 0)
				triggerBtn.BackgroundTransparency = 1
