local function HookWindow(Window)
	if not Window or type(Window) ~= "table" or Window.__SearchHooked then return Window end
	Window.__SearchHooked = true

	local OriginalAddTab = Window.AddTab
	local CurrentTabIndex = 0
	local SidebarOrder = {}
	local CurrentSidebarSection = nil
	local CurrentActiveButton = nil
	local CurrentActiveSection = nil
	local TabSectionByIndex = {}
	local TabSectionByObject = {}
	local SelectorCache = nil

	if Window.Root then
		Window.Root.Destroying:Connect(function()
			for _, cb in ipairs(DestroyCallbacks) do pcall(cb) end
			DisconnectTracked()
			table.clear(SearchIndex)
			table.clear(AllSectionTitles)
			table.clear(SectionExpandersByTitle)
			table.clear(AllCreatedTabSections)
			table.clear(SidebarOrder)
			table.clear(TabButtonsOnly)
			table.clear(TabButtonByTab)
			table.clear(TabSectionByButton)
			SelectorCache = nil
			CurrentActiveButton = nil
			CurrentActiveSection = nil
			if Library.CurrentWindow == Window then Library.CurrentWindow = nil end
		end)
	end

	local function FindSelector()
		if SelectorCache and SelectorCache.Parent then return SelectorCache end
		SelectorCache = nil
		if typeof(Window.Selector) == "Instance" then
			SelectorCache = Window.Selector
			return SelectorCache
		end
		if not Window.Root then return nil end

		for _, d in ipairs(Window.Root:GetDescendants()) do
			if d:IsA("GuiObject") and d.Name == "Selector" then
				SelectorCache = d
				return d
			end
		end

		local holder = Window.TabHolder
		if holder and holder.Parent then
			for _, d in ipairs(holder.Parent:GetDescendants()) do
				if d:IsA("GuiObject") and not d:IsA("GuiButton") and not d:IsA("TextLabel") and not d:IsA("ScrollingFrame") then
					local w = d.Size.X.Offset
					if w >= 2 and w <= 6 then
						SelectorCache = d
						return d
					end
				end
			end
		end
		return nil
	end

	local function UpdateSectionHighlights()
		local brightness = (TargetTextColor.R + TargetTextColor.G + TargetTextColor.B) / 3
		local isDark = (brightness > 0.5)
		local dimColor = isDark and Color3.fromRGB(160, 160, 160) or Color3.fromRGB(110, 110, 110)

		for _, sec in ipairs(AllCreatedTabSections) do
			if sec and sec.Label and sec.Label.Parent then
				local isHovering = sec.Label:GetAttribute("Hovering") == true
				local isActiveAndOpen = (CurrentActiveSection == sec) and (sec.Expanded == true)
				local isHighlighted = isHovering or isActiveAndOpen

				sec.Label:SetAttribute("IsActiveSection", isActiveAndOpen)

				local targetCol = isHighlighted and TargetTextColor or dimColor
				TweenService:Create(sec.Label, TweenInfo.new(0.15), {TextColor3 = targetCol}):Play()
				local arrow = sec.Label:FindFirstChild("SectionArrow")
				if arrow then 
					TweenService:Create(arrow, TweenInfo.new(0.15), {ImageColor3 = targetCol}):Play()
				end
			end
		end
	end
	Window.UpdateSectionHighlights = UpdateSectionHighlights

	Window.SyncSelector = function()
		local sel = FindSelector()
		if not sel then return end

		if not CurrentActiveButton and #TabButtonsOnly > 0 then
			CurrentActiveButton = TabButtonsOnly[1]
			CurrentActiveSection = TabSectionByButton[CurrentActiveButton]
		end

		local btn = CurrentActiveButton
		local sec = CurrentActiveSection or (btn and TabSectionByButton[btn])

		if sec and sec.Expanded == false then
			sel.Visible = false
			return
		end

		if not btn or not btn.Parent or btn.Visible == false then
			sel.Visible = false
			return
		end

		sel.Visible = true
		UpdateSectionHighlights()
	end

	local OriginalSelectTab = Window.SelectTab
	if OriginalSelectTab then
		Window.SelectTab = function(self, tabArg)
			local res = OriginalSelectTab(self, tabArg)
			local btn = nil

			if type(tabArg) == "number" then
				btn = TabButtonsOnly[tabArg]
			elseif type(tabArg) == "table" then
				btn = TabButtonByTab[tabArg] or tabArg._ButtonInstance
			end

			if btn then
				CurrentActiveButton = btn
				CurrentActiveSection = TabSectionByButton[btn]
			end

			local sel = FindSelector()
			if sel then sel.Visible = true end
			UpdateSectionHighlights()

			return res
		end
	end

	local function RelayoutSidebar()
		local holder = Window.TabHolder
		if not holder then return end
		local layout = holder:FindFirstChildOfClass("UIListLayout")
		if layout then layout.SortOrder = Enum.SortOrder.LayoutOrder end
		local n = 0
		for _, obj in ipairs(SidebarOrder) do
			if obj and obj.Parent then
				n += 1
				obj.LayoutOrder = n
			end
		end
	end

	Window.AddTab = function(self, ...)
		local args = {...}
		local tabOptions = nil
		local explicitSec = nil

		for _, arg in ipairs(args) do
			if type(arg) == "table" then
				if arg.Tabs and arg.Set then
					explicitSec = arg
				elseif not tabOptions then
					tabOptions = arg
				end
			end
		end

		if not explicitSec and type(self) == "table" and self.Tabs and self.Set then
			explicitSec = self
		end

		local targetSec = explicitSec or CurrentSidebarSection
		tabOptions = tabOptions or {}

		CurrentTabIndex += 1
		local ThisTabIndex = CurrentTabIndex

		local holder = Window.TabHolder
		local before = {}
		if holder then
			for _, c in ipairs(holder:GetChildren()) do before[c] = true end
		end

		local tabObj = OriginalAddTab(Window, tabOptions)

		if holder then
			for _, c in ipairs(holder:GetChildren()) do
				if not before[c] and c:IsA("GuiButton") then
					c:SetAttribute("OriginalOrder", c.LayoutOrder)
					table.insert(SidebarOrder, c)
					table.insert(TabButtonsOnly, c)

					if type(tabObj) == "table" then
						TabButtonByTab[tabObj] = c
						rawset(tabObj, "_ButtonInstance", c)
						rawset(tabObj, "_SectionRef", targetSec)
					end

					if targetSec then
						table.insert(targetSec.Tabs, c)
						TabSectionByIndex[ThisTabIndex] = targetSec
						TabSectionByButton[c] = targetSec
						if type(tabObj) == "table" then 
							TabSectionByObject[tabObj] = targetSec 
						end
						c.Visible = targetSec.Expanded
					end

					if not CurrentActiveButton then
						CurrentActiveButton = c
						CurrentActiveSection = targetSec
					end

					c.MouseButton1Click:Connect(function()
						CurrentActiveButton = c
						CurrentActiveSection = targetSec
						local sel = FindSelector()
						if sel then sel.Visible = true end
						UpdateSectionHighlights()
					end)
					break
				end
			end
			RelayoutSidebar()
		end

		local TabName = tabOptions.Title or "Unknown"
		local CurrentSection = TabName

		local ctx = {
			TabName = TabName,
			TabIndex = ThisTabIndex,
			GetSection = function() return CurrentSection end,
			SetSection = function(v) CurrentSection = tostring(v or TabName) end
		}

		HookContainer(tabObj, ctx)
		RecordElement(ctx, "Misc", TabName, tabObj)

		return tabObj
	end

	Window.ExpandTabSection = function(_, tabIndex)
		local sec = TabSectionByIndex[tabIndex]
		if sec and not sec.Expanded then
			sec.Set(true)
		end
	end

	if Window.TabHolder then
		Window.AddTabSection = function(self, ...)
			local args = {...}
			local sectionTitle = args[1]
			local defaultExpanded = args[2]

			local sec = {Tabs = {}, Expanded = defaultExpanded ~= false}

			local sectionLabel = Instance.new("TextLabel")
			sectionLabel.Name = "FluentRenewedTabSection"
			sectionLabel.BackgroundTransparency = 1
			sectionLabel.Size = UDim2.new(1, 0, 0, 24)
			sectionLabel.Font = Enum.Font.GothamBold
			sectionLabel.Text = string.upper(tostring(sectionTitle or ""))
			sectionLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
			sectionLabel.TextSize = 11
			sectionLabel.TextXAlignment = Enum.TextXAlignment.Left
			sectionLabel.TextYAlignment = Enum.TextYAlignment.Center
			sectionLabel.Parent = Window.TabHolder

			local pad = Instance.new("UIPadding", sectionLabel)
			pad.PaddingLeft = UDim.new(0, 10)

			local arrow = Instance.new("ImageLabel")
			arrow.Name = "SectionArrow"
			arrow.BackgroundTransparency = 1
			arrow.Image = "rbxassetid://10709790948"
			arrow.ImageColor3 = Color3.fromRGB(160, 160, 160)
			arrow.Size = UDim2.fromOffset(12, 12)
			arrow.AnchorPoint = Vector2.new(1, 0.5)
			arrow.Position = UDim2.new(1, -2, 0.5, 0)
			arrow.Rotation = sec.Expanded and 180 or 0
			arrow.Parent = sectionLabel

			local trigger = Instance.new("TextButton")
			trigger.Name = "SectionTrigger"
			trigger.BackgroundTransparency = 1
			trigger.Text = ""
			trigger.AutoButtonColor = false
			trigger.Size = UDim2.fromScale(1, 1)
			trigger.ZIndex = sectionLabel.ZIndex + 2
			trigger.Parent = sectionLabel

			sec.Label = sectionLabel
			sec.Set = function(state)
				if sec.Expanded == state then return end
				sec.Expanded = state
				TweenService:Create(arrow, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Rotation = state and 180 or 0
				}):Play()
				for _, tabButton in ipairs(sec.Tabs) do
					if tabButton and tabButton.Parent then
						tabButton.Visible = state
					end
				end

				local sel = FindSelector()
				if sel then
					if CurrentActiveSection == sec then
						sel.Visible = state
					end
				end

				UpdateSectionHighlights()
			end

			trigger.MouseButton1Click:Connect(function() sec.Set(not sec.Expanded) end)
			trigger.MouseEnter:Connect(function()
				sectionLabel:SetAttribute("Hovering", true)
				TweenService:Create(sectionLabel, TweenInfo.new(0.15), {TextColor3 = TargetTextColor}):Play()
				TweenService:Create(arrow, TweenInfo.new(0.15), {ImageColor3 = TargetTextColor}):Play()
			end)
			trigger.MouseLeave:Connect(function()
				sectionLabel:SetAttribute("Hovering", false)
				UpdateSectionHighlights()
			end)

			table.insert(AllCreatedTabSections, sec)
			CurrentSidebarSection = sec
			table.insert(SidebarOrder, sectionLabel)
			RelayoutSidebar()

			local sectionApi = {}
			setmetatable(sectionApi, { __index = sec })

			function sectionApi:AddTab(tabOptions)
				return Window:AddTab(tabOptions, sec)
			end
			sectionApi.CreateTab = sectionApi.AddTab
			function sectionApi:Expand() sec.Set(true) end
			function sectionApi:Collapse() sec.Set(false) end
			function sectionApi:Toggle() sec.Set(not sec.Expanded) end

			return sectionApi
		end
		Window.TabSection = Window.AddTabSection
		Window.CreateTabSection = Window.AddTabSection
	end

	task.spawn(function()
		task.wait(0.1)
		pcall(function()
			local ScreenGui = Window.Root and Window.Root:FindFirstAncestorWhichIsA("ScreenGui")
			if ScreenGui then
				ScreenGui.IgnoreGuiInset = true
			end
		end)
	end)

	if Window.Root then
		local Root = Window.Root
		local savedPos = Root.Position
		local savedSize = Root.Size
		local activeTween = nil

		local function PlayRootTween(props)
			if activeTween then activeTween:Cancel() end
			activeTween = TweenService:Create(Root, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			activeTween:Play()
		end

		Window.Maximize = function(...)
			local args = {...}
			local targetState = nil

			for _, v in ipairs(args) do
				if type(v) == "boolean" then
					targetState = v
					break
				end
			end

			local shouldMaximize
			if targetState ~= nil then
				shouldMaximize = targetState
			else
				shouldMaximize = not Window.Maximized
			end

			if not shouldMaximize then
				Window.Maximized = false
				PlayRootTween({
					Position = savedPos,
					Size = savedSize
				})
			else
				if not Window.Maximized then
					savedPos = Root.Position
					savedSize = Root.Size
				end
				Window.Maximized = true
				PlayRootTween({
					Position = UDim2.new(0, 0, 0, 0),
					Size = UDim2.new(1, 0, 1, 0)
				})
			end

			local overlay = Root and Root:FindFirstChild("SpotlightOverlay")
			if overlay and overlay.Visible then
				task.defer(function()
					local spotResults = overlay:FindFirstChild("SpotResults", true)
					if spotResults then
						local count = 0
						for _, child in ipairs(spotResults:GetChildren()) do
							if child:IsA("TextButton") then count += 1 end
						end
						local isMax = Window.Maximized or false
						local widthScale = isMax and 0.88 or 0.85
						local rootH = Root.AbsoluteSize.Y
						local maxAllowedHeight = math.clamp(rootH - SPOTLIGHT_TOP_OFFSET - 35, 100, 750)
						local totalHeight = math.min(count * 34 + 52, maxAllowedHeight)
						if count == 0 then totalHeight = 45 end

						local spotFrame = overlay:FindFirstChild("SpotlightFrame") or overlay:FindFirstChildOfClass("Frame")
						if spotFrame then
							spotFrame.AnchorPoint = Vector2.new(0.5, 0)
							TweenService:Create(spotFrame, TweenInfo.new(0.12), {
								Size = UDim2.new(widthScale, 0, 0, totalHeight),
								Position = UDim2.new(0.5, 0, 0, SPOTLIGHT_TOP_OFFSET)
							}):Play()
						end
					end
				end)
			end
		end

		local TITLEBAR_HEIGHT = 42
		local TITLEBAR_BUTTONS_WIDTH = 130
		local DRAG_THRESHOLD = 4

		local function PointerToGui(input)
			local p = Vector2.new(input.Position.X, input.Position.Y)
			local gui = Root:FindFirstAncestorWhichIsA("ScreenGui")
			if gui and gui.IgnoreGuiInset then
				local inset = GuiService:GetGuiInset()
				p = p + inset
			end
			return p
		end

		local DragHandle = Instance.new("TextButton")
		DragHandle.Name = "WindowDragHandle"
		DragHandle.BackgroundTransparency = 1
		DragHandle.Text = ""
		DragHandle.AutoButtonColor = false
		DragHandle.Active = true
		DragHandle.Position = UDim2.new(0, 0, 0, 0)
		DragHandle.Size = UDim2.new(1, -TITLEBAR_BUTTONS_WIDTH, 0, TITLEBAR_HEIGHT)
		DragHandle.ZIndex = 500
		DragHandle.Parent = Root

		local dragging = false
		local dragInputObj = nil
		local startPointer = Vector2.zero
		local startPos = Root.Position

		DragHandle.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			dragging = true
			dragInputObj = input
			startPointer = PointerToGui(input)
			startPos = Root.Position
			local endConn
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					dragInputObj = nil
					pcall(function() Window.Position = Root.Position end)
					endConn:Disconnect()
				end
			end)
		end)

		Track(UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			local isTouch = input.UserInputType == Enum.UserInputType.Touch and input == dragInputObj
			if not (isMove or isTouch) then return end

			local pointer = PointerToGui(input)
			local delta = pointer - startPointer

			if Window.Maximized then
				if delta.Magnitude < DRAG_THRESHOLD then return end
				if activeTween then
					activeTween:Cancel()
					activeTween = nil
				end

				local anchor = Root.AnchorPoint
				local curAbs = Root.AbsolutePosition
				local curSize = Root.AbsoluteSize
				local curPos = Root.Position
				local origin = curAbs - Vector2.new(curPos.X.Offset, curPos.Y.Offset) + Vector2.new(anchor.X * curSize.X, anchor.Y * curSize.Y)

				local parent = Root.Parent
				local parentSize = (parent and parent:IsA("GuiBase2d")) and parent.AbsoluteSize or workspace.CurrentCamera.ViewportSize
				local newSize = Vector2.new(
					savedSize.X.Scale * parentSize.X + savedSize.X.Offset,
					savedSize.Y.Scale * parentSize.Y + savedSize.Y.Offset
				)

				local ratioX = math.clamp((startPointer.X - curAbs.X) / math.max(curSize.X, 1), 0, 1)
				local grabY = math.clamp(startPointer.Y - curAbs.Y, 0, TITLEBAR_HEIGHT)
				local topLeft = Vector2.new(pointer.X - ratioX * newSize.X, math.max(pointer.Y - grabY, origin.Y))

				Window.Maximized = false
				Root.Size = savedSize
				Root.Position = UDim2.fromOffset(
					topLeft.X - origin.X + anchor.X * newSize.X,
					topLeft.Y - origin.Y + anchor.Y * newSize.Y
				)

				startPointer = pointer
				startPos = Root.Position
				return
			end

			Root.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end))
	end

	task.spawn(function()
		task.wait(0.1)
		CustomizeLibrary(Window)
	end)

	return Window
end

Library.CreateWindow = function(self, ...)
	local Window = OriginalCreateWindow(self, ...)
	local HookedWindow = HookWindow(Window)
	Library.CurrentWindow = HookedWindow
	return HookedWindow
end

if OriginalWindowCtor then
	Library.Window = function(self, ...)
		local Window = OriginalWindowCtor(self, ...)
		local HookedWindow = HookWindow(Window)
		Library.CurrentWindow = HookedWindow
		return HookedWindow
	end
end

