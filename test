			if SettingsLabelRef then TargetTextColor = SettingsLabelRef.TextColor3 end
			if SettingsButtonRef then TargetBgColor = SettingsButtonRef.BackgroundColor3 end

			local brightness = (TargetTextColor.R + TargetTextColor.G + TargetTextColor.B) / 3
			local SubColor = (brightness > 0.5) and Color3.fromRGB(160, 160, 160) or Color3.fromRGB(100, 100, 100)
			local stroke = RootFrame:FindFirstChild("UIStroke")

			SearchText.TextColor3 = TargetTextColor
			SearchIcon.ImageColor3 = TargetTextColor
			DisplayName.TextColor3 = TargetTextColor
			UserName.TextColor3 = SubColor

			SpotInput.TextColor3 = TargetTextColor
			SpotIcon.ImageColor3 = TargetTextColor
			SpotInput.PlaceholderColor3 = SubColor
			SpotSeparator.BackgroundColor3 = SubColor

			-- Restored original dynamic color handling for dashboard card and theme backgrounds
			if DashboardOverlay.Visible then
				local windowBg = (GradientRef and GradientRef.Color and #GradientRef.Color.Keypoints > 0) and GradientRef.Color.Keypoints[1].Value or Color3.fromRGB(15, 20, 28)
				local cardBaseColor = Color3.new(math.clamp(windowBg.R * 0.72, 0, 1), math.clamp(windowBg.G * 0.72, 0, 1), math.clamp(windowBg.B * 0.72, 0, 1))
				local boxFill = Color3.new(math.clamp(windowBg.R * 0.48, 0, 1), math.clamp(windowBg.G * 0.48, 0, 1), math.clamp(windowBg.B * 0.48, 0, 1))
				local boxOutline = stroke and stroke.Color or SubColor

				DashboardCard.BackgroundColor3 = cardBaseColor
				DashTitle.TextColor3 = TargetTextColor
				DashClose.TextColor3 = TargetTextColor
				DashStroke.Color = boxOutline

				for _, item in ipairs(StatCardFrames) do
					item.card.BackgroundColor3 = boxFill
					item.stroke.Color = boxOutline
					item.stroke.Transparency = 0.75
				end

				for _, lbl in ipairs(StatCardTitles) do lbl.TextColor3 = TargetTextColor end
				for _, val in ipairs(StatCardValues) do val.TextColor3 = SubColor end
			end

			if GradientRef then
				SpotlightGradient.Color = GradientRef.Color
				SpotlightGradient.Rotation = GradientRef.Rotation
				SpotlightFrame.BackgroundColor3 = Color3.new(1,1,1)
			else
				SpotlightFrame.BackgroundColor3 = TargetBgColor
			end

			if stroke then
				SearchStroke.Color = stroke.Color
				AvatarStroke.Color = stroke.Color
				SpotlightStroke.Color = stroke.Color
				DashStroke.Color = stroke.Color
			else
				SearchStroke.Transparency = 1
			end
		end)
	end
	RunService.RenderStepped:Connect(UpdateColors)

	local CurrentFlashColor = Color3.fromRGB(255, 255, 255)

	local function ScrollToTargetCentered(target)
		if not target then return end
		local curr = target
		while curr and curr.Parent and not curr.Parent:IsA("ScrollingFrame") do curr = curr.Parent end
		local sf = curr and curr:FindFirstAncestorWhichIsA("ScrollingFrame")
		if not sf then return end

		local padTop = sf:FindFirstChildOfClass("UIPadding") and sf:FindFirstChildOfClass("UIPadding").PaddingTop.Offset or 0
		local desiredY = math.clamp((target.AbsolutePosition.Y - sf.AbsolutePosition.Y) + sf.CanvasPosition.Y - padTop - (sf.AbsoluteWindowSize.Y * 0.5) + (target.AbsoluteSize.Y * 0.5), 0, math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y))

		local existingOverlay = target:FindFirstChild("SearchFlashOverlay")
		if existingOverlay then existingOverlay:Destroy() end

		local targetCorner = target:FindFirstChildOfClass("UICorner")
		local cornerRadius = targetCorner and targetCorner.CornerRadius or UDim.new(0, 8)

		local overlay = Instance.new("Frame", target)
		overlay.Name = "SearchFlashOverlay"
		overlay.BackgroundTransparency = 1
		overlay.BorderSizePixel = 0
		overlay.Size = UDim2.new(1, -2, 1, -2)
		overlay.Position = UDim2.new(0, 1, 0, 1)
		overlay.ZIndex = math.max((target.ZIndex or 1) + 10, 20)

		local corner = Instance.new("UICorner", overlay)
		corner.CornerRadius = cornerRadius

		local stroke = Instance.new("UIStroke", overlay)
		stroke.Name = "SearchFlashStroke"
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Thickness = 2
		stroke.Color = CurrentFlashColor
		stroke.Transparency = 1

		sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, desiredY)

		task.spawn(function()
			for _ = 1, 3 do
				if not overlay.Parent then break end
				local t1 = TweenService:Create(stroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0})
				t1:Play(); t1.Completed:Wait()
				task.wait(0.04)
				local t2 = TweenService:Create(stroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1})
				t2:Play(); t2.Completed:Wait()
				task.wait(0.04)
			end
			if overlay then overlay:Destroy() end
		end)
	end

	local function UpdateSearchResults()
		local query = SpotInput.Text:lower()
		for _, v in pairs(SpotResults:GetChildren()) do
			if v:IsA("TextButton") then v:Destroy() end
		end

		local hits = 0
		for _, item in ipairs(SearchIndex) do
			if query == "" or tostring(item.Name):lower():find(query, 1, true) then
				hits += 1

				local btn = Create("TextButton", {
					Parent = SpotResults, BackgroundColor3 = Sidebar.BackgroundColor3,
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32),
					Text = "", AutoButtonColor = false, ZIndex = 10005, Active = true
				})
				Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = btn})

				local btnStroke = Create("UIStroke", {
					Parent = btn, Thickness = 1, Transparency = 1,
					Color = SpotInput.TextColor3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				})

				Create("ImageLabel", {
					Name = "Icon", Parent = btn, BackgroundTransparency = 1,
					Image = (Icons[item.Type] and Icons[item.Type].Image) or Icons[item.Type] or Icons.Misc,
					ImageColor3 = SpotInput.TextColor3, Position = UDim2.new(0, 8, 0.5, -8),
					Size = UDim2.fromOffset(16, 16), ZIndex = 10006
				})

				Create("TextLabel", {
					Name = "Title", Parent = btn, BackgroundTransparency = 1,
					Text = item.Name, TextColor3 = SpotInput.TextColor3,
					Font = Enum.Font.GothamMedium, TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, 32, 0, 0), Size = UDim2.new(1, -32, 1, 0), ZIndex = 10006
				})

				btn.MouseEnter:Connect(function()
					TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.95}):Play()
					TweenService:Create(btnStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
				end)
				btn.MouseLeave:Connect(function()
					TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
					TweenService:Create(btnStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
				end)

				btn.MouseButton1Click:Connect(function()
					if item.Section and SectionExpandersByTitle[tostring(item.Section):lower()] then
						SectionExpandersByTitle[tostring(item.Section):lower()]()
					end

					TweenService:Create(SpotlightOverlay, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
					SpotlightOverlay.Visible = false
					SpotInput.Text = ""

					pcall(function() Window:SelectTab(item.TabIndex) end)
					RunService.RenderStepped:Wait()
					ScrollToTargetCentered(item.Frame)
				end)
			end
		end

		local totalHeight = math.min(hits * 34 + 52, 300)
		if hits == 0 then totalHeight = 45 end
		TweenService:Create(SpotlightFrame, TweenInfo.new(0.1), {Size = UDim2.new(0, 500, 0, totalHeight)}):Play()
		SpotResults.CanvasSize = UDim2.new(0, 0, 0, hits * 34)
	end

	SpotInput:GetPropertyChangedSignal("Text"):Connect(UpdateSearchResults)

	SearchTab.MouseButton1Click:Connect(function()
		SpotlightOverlay.Visible = true
		TweenService:Create(SpotlightOverlay, TweenInfo.new(0.15), {BackgroundTransparency = 0.5}):Play()
		SpotInput:CaptureFocus()
		UpdateSearchResults()
	end)

	local CloseBtn = Create("TextButton", {
		Parent = SpotlightOverlay, Size = UDim2.new(1,0,1,0),
		BackgroundTransparency = 1, Text = "", ZIndex = 9999
	})
	CloseBtn.MouseButton1Click:Connect(function()
		TweenService:Create(SpotlightOverlay, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
		task.wait(0.15)
		SpotlightOverlay.Visible = false
	end)
end

local function HookWindow(Window)
	if not Window or type(Window) ~= "table" or Window.__SearchHooked then return Window end
	Window.__SearchHooked = true

	local OriginalAddTab = Window.AddTab
	local CurrentTabIndex = 0

	Window.AddTab = function(self, tabOptions)
		CurrentTabIndex += 1
		local ThisTabIndex = CurrentTabIndex
		local Tab = OriginalAddTab(self, tabOptions)
		local TabName = tabOptions.Title or "Unknown"
		local CurrentSection = TabName

		local ctx = {
			TabName = TabName,
			TabIndex = ThisTabIndex,
			GetSection = function() return CurrentSection end,
			SetSection = function(v) CurrentSection = tostring(v or TabName) end
		}

		HookContainer(Tab, ctx)
		RecordElement(ctx, "Misc", TabName, Tab)
		return Tab
	end

	if not Window.AddTabSection then
		Window.AddTabSection = function(self, sectionTitle)
			local tabHolder = Window.TabHolder
			if not tabHolder then return end
			local dividerContainer = Instance.new("Frame", tabHolder)
			dividerContainer.BackgroundTransparency = 1
			dividerContainer.Size = UDim2.new(1, 0, 0, 24)
			dividerContainer.LayoutOrder = #tabHolder:GetChildren()

			local label = Instance.new("TextLabel", dividerContainer)
			label.BackgroundTransparency = 1
			label.Position = UDim2.new(0, 8, 0, 4)
			label.Size = UDim2.new(1, -16, 1, -4)
			label.Font = Enum.Font.GothamBold
			label.Text = string.upper(tostring(sectionTitle))
			label.TextColor3 = Color3.fromRGB(140, 145, 155)
			label.TextSize = 10
			label.TextXAlignment = Enum.TextXAlignment.Left
			return dividerContainer
		end
	end

	task.spawn(function()
		task.wait(0.1)
		pcall(function()
			local ScreenGui = Window.Root and Window.Root:FindFirstAncestorWhichIsA("ScreenGui")
			if ScreenGui then ScreenGui.IgnoreGuiInset = true end
		end)
		CustomizeLibrary(Window)
	end)

	return Window
end

Library.CreateWindow = function(self, options)
	local Window = HookWindow(OriginalCreateWindow(self, options))
	Library.CurrentWindow = Window
	return Window
end

if OriginalWindowCtor then
	Library.Window = function(self, options)
		local Window = HookWindow(OriginalWindowCtor(self, options))
		Library.CurrentWindow = Window
		return Window
	end
end

