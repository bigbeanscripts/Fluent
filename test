local function ColorToHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end

local function GetTitle(arg1, arg2)
	if type(arg2) == "table" and arg2.Title then return tostring(arg2.Title) end
	if type(arg1) == "table" and arg1.Title then return tostring(arg1.Title) end
	if type(arg1) == "string" then return tostring(arg1) end
	return "No Title"
end

local function GetFrameFromElement(Element)
	if typeof(Element) == "Instance" then
		return Element
	end
	if type(Element) == "table" then
		for _, k in ipairs({"Frame", "Root", "Container", "Holder", "Instance"}) do
			local success, f = pcall(function() return Element[k] end)
			if success and typeof(f) == "Instance" then return f end
		end
	end
	return nil
end

local function GetScrollFrame(obj)
	if type(obj) ~= "table" then return nil end
	for _, k in ipairs({"Container", "Frame", "Scroll", "Page", "Holder", "Root"}) do
		local val = rawget(obj, k)
		if typeof(val) == "Instance" and val:IsA("ScrollingFrame") then
			return val
		end
	end
	return nil
end

local function RecordElement(ctx, typeName, displayTitle, elementObj)
	if not displayTitle or displayTitle == "" then return end
	if elementObj and ObjectSet[elementObj] then return end
	if elementObj then ObjectSet[elementObj] = true end

	table.insert(SearchIndex, {
		Name = displayTitle,
		Type = typeName,
		Tab = ctx.TabName or "Unknown",
		TabCategory = ctx.TabCategory or "",
		Section = (ctx.GetSection and ctx.GetSection()) or (ctx.TabName or "Unknown"),
		TabIndex = ctx.TabIndex or 1,
		Object = elementObj,
		Frame = GetFrameFromElement(elementObj)
	})
end

local function HookContainer(container, ctx)
	if not container or container.__Aliased then return container end
	container.__Aliased = true

	local function wrapMethod(methodName, typeName)
		if container[methodName] and not container["__Hook" .. methodName] then
			container["__Hook" .. methodName] = true
			local Old = container[methodName]
			container[methodName] = function(self, arg1, arg2, ...)
				local el = Old(self, arg1, arg2, ...)
				local title = GetTitle(arg1, arg2)
				RecordElement(ctx, typeName, title, el)
				return el
			end
		end
	end

	wrapMethod("AddToggle", "Toggle")
	wrapMethod("AddDropdown", "Dropdown")
	wrapMethod("AddButton", "Button")
	wrapMethod("AddParagraph", "Paragraph")
	wrapMethod("AddSlider", "Slider")
	wrapMethod("AddInput", "Input")
	wrapMethod("AddKeybind", "Keybind")

	if container.AddSection and not container.__SectionHooked then
		container.__SectionHooked = true
		local OldAddSection = container.AddSection

		container.AddSection = function(self, arg1, arg2, ...)
			local title = GetTitle(arg1, arg2)
			if ctx.SetSection then ctx.SetSection(title) end

			local defaultExpanded = true
			if type(arg2) == "boolean" then
				defaultExpanded = arg2
			elseif type(arg1) == "table" and type(arg1.Default) == "boolean" then
				defaultExpanded = arg1.Default
			end

			local isExpanded = defaultExpanded
			local scrollFrame = GetScrollFrame(self)

			local sec = OldAddSection(self, tostring(title or "Section"))
			RecordElement(ctx, "Section", title, sec)

			local secFrame = nil
			if scrollFrame then
				local children = scrollFrame:GetChildren()
				secFrame = children[#children]
			end

			local childFrames = {}
			local titleLabel = secFrame and (secFrame:FindFirstChild("Title") or secFrame:FindFirstChildOfClass("TextLabel"))
			local arrowIcon = nil

			local function SetExpanded(state)
				if isExpanded == state then return end
				isExpanded = state
				if arrowIcon then
					TweenService:Create(arrowIcon, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Rotation = isExpanded and 0 or 180
					}):Play()
				end
				for _, fr in ipairs(childFrames) do
					if fr and fr.Parent then
						fr.Visible = isExpanded
					end
				end
			end

			local expandAction = function()
				SetExpanded(true)
			end

			SectionExpandersByTitle[tostring(title):lower()] = expandAction
			if secFrame then
				SectionExpanders[secFrame] = expandAction
			end

			if titleLabel then
				titleLabel.AutomaticSize = Enum.AutomaticSize.Y
				titleLabel.Size = UDim2.new(1, 0, 0, 18)
				table.insert(AllSectionTitles, titleLabel)

				arrowIcon = Instance.new("ImageLabel")
				arrowIcon.Name = "CollapseArrow"
				arrowIcon.BackgroundTransparency = 1
				arrowIcon.Image = "rbxassetid://10709790948"
				arrowIcon.ImageColor3 = TargetTextColor
				arrowIcon.Size = UDim2.fromOffset(14, 14)
				arrowIcon.AnchorPoint = Vector2.new(1, 0.5)
				arrowIcon.Position = UDim2.new(1, -6, 0.5, 0)
				arrowIcon.Rotation = isExpanded and 0 or 180
				arrowIcon.ZIndex = 20
				arrowIcon.Parent = titleLabel

				local triggerBtn = Instance.new("TextButton")
				triggerBtn.Name = "CollapsibleTrigger"
				triggerBtn.Size = UDim2.fromScale(1, 1)
				triggerBtn.Position = UDim2.new(0, 0, 0, 0)
				triggerBtn.BackgroundTransparency = 1
				triggerBtn.Text = ""
				triggerBtn.ZIndex = 25
				triggerBtn.Parent = titleLabel

				table.insert(ActiveConnections, triggerBtn.MouseEnter:Connect(function()
					local hoverColor = Color3.fromRGB(255, 255, 255)
					TweenService:Create(titleLabel, TweenInfo.new(0.15), {TextColor3 = hoverColor}):Play()
					TweenService:Create(arrowIcon, TweenInfo.new(0.15), {ImageColor3 = hoverColor}):Play()
				end))

				table.insert(ActiveConnections, triggerBtn.MouseLeave:Connect(function()
					TweenService:Create(titleLabel, TweenInfo.new(0.15), {TextColor3 = TargetTextColor}):Play()
					TweenService:Create(arrowIcon, TweenInfo.new(0.15), {ImageColor3 = TargetTextColor}):Play()
				end))

				table.insert(ActiveConnections, triggerBtn.MouseButton1Click:Connect(function()
					SetExpanded(not isExpanded)
				end))
			end

			local sub = {}
			setmetatable(sub, { __index = sec })

			local methods = {"AddToggle", "AddDropdown", "AddButton", "AddParagraph", "AddSlider", "AddInput", "AddKeybind"}
			for _, m in ipairs(methods) do
				sub[m] = function(_, ...)
					local countBefore = scrollFrame and #scrollFrame:GetChildren() or 0
					local el = self[m](self, ...)

					if scrollFrame then
						local newChildren = scrollFrame:GetChildren()
						for i = countBefore + 1, #newChildren do
							local itemFrame = newChildren[i]
							if itemFrame:IsA("GuiObject") and itemFrame ~= secFrame then
								itemFrame.Visible = isExpanded
								table.insert(childFrames, itemFrame)
								SectionExpanders[itemFrame] = expandAction
							end
						end
					end

					return el
				end
			end

			sub.Toggle = sub.AddToggle
			sub.Dropdown = sub.AddDropdown
			sub.Button = sub.AddButton
			sub.Paragraph = sub.AddParagraph
			sub.Slider = sub.AddSlider
			sub.Input = sub.AddInput
			sub.Keybind = sub.AddKeybind

			sub.CreateToggle = sub.AddToggle
			sub.CreateDropdown = sub.AddDropdown
			sub.CreateButton = sub.AddButton
			sub.CreateParagraph = sub.AddParagraph
			sub.CreateSlider = sub.AddSlider
			sub.CreateInput = sub.AddInput
			sub.CreateKeybind = sub.AddKeybind

			return sub
		end

		container.Section = function(self, ...) return self:AddSection(...) end
		container.CreateSection = function(self, ...) return self:AddSection(...) end
		container.AddCollapsible = function(self, ...) return self:AddSection(...) end
		container.Collapsible = function(self, ...) return self:AddSection(...) end
	end

	local aliasList = {"Toggle", "Dropdown", "Button", "Paragraph", "Slider", "Input", "Keybind"}
	for _, name in ipairs(aliasList) do
		if container["Add" .. name] then
			container[name] = container["Add" .. name]
			container["Create" .. name] = container["Add" .. name]
		end
	end

	return container
end

