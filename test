	local function PickFlashTarget(node)
		if not node or typeof(node) ~= "Instance" then return nil end
		local curr = node
		while curr and curr.Parent and not curr.Parent:IsA("ScrollingFrame") do
			curr = curr.Parent
		end
		return curr or node
	end

	local function ScrollToTargetCentered(target)
		if not target then return end
		target = PickFlashTarget(target)
		if not target then return end

		local sf = target:FindFirstAncestorWhichIsA("ScrollingFrame")
		if not sf then return end

		local padTop = 0
		local pad = sf:FindFirstChildOfClass("UIPadding")
		if pad then padTop = pad.PaddingTop.Offset end

		local viewH = sf.AbsoluteWindowSize.Y
		local targetH = target.AbsoluteSize.Y
		local relY = (target.AbsolutePosition.Y - sf.AbsolutePosition.Y) + sf.CanvasPosition.Y - padTop
		local desiredY = relY - (viewH * 0.5) + (targetH * 0.5)

		local maxScroll = math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y)
		desiredY = math.clamp(desiredY, 0, maxScroll)

		local existingOverlay = target:FindFirstChild("SearchFlashOverlay")
		if existingOverlay then existingOverlay:Destroy() end

		local targetCorner = target:FindFirstChildOfClass("UICorner")
		local cornerRadius = targetCorner and targetCorner.CornerRadius or UDim.new(0, 8)

		local overlay = Instance.new("Frame")
		overlay.Name = "SearchFlashOverlay"
		overlay.BackgroundTransparency = 1
		overlay.BorderSizePixel = 0
		overlay.Size = UDim2.new(1, -2, 1, -2)
		overlay.Position = UDim2.new(0, 1, 0, 1)
		overlay.ZIndex = math.max((target.ZIndex or 1) + 10, 20)
		overlay.Parent = target

		local corner = Instance.new("UICorner", overlay)
		corner.CornerRadius = cornerRadius

		local flashStroke = Instance.new("UIStroke")
		flashStroke.Name = "SearchFlashStroke"
		flashStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		flashStroke.Thickness = 2
		flashStroke.Color = CurrentFlashColor
		flashStroke.Transparency = 1
		flashStroke.Parent = overlay

		sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X, desiredY)

		task.spawn(function()
			for _ = 1, 3 do
				if not overlay.Parent then break end
				local t1 = TweenService:Create(flashStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0})
				t1:Play()
				t1.Completed:Wait()
				task.wait(0.04)
				local t2 = TweenService:Create(flashStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1})
				t2:Play()
				t2.Completed:Wait()
				task.wait(0.04)
			end
			if overlay then overlay:Destroy() end
		end)
	end

