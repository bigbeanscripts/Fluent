	local function UpdateColors()
		pcall(function()
			if not RootFrame or not RootFrame.Parent then return end

			if not SettingsLabelRef or not SettingsButtonRef or not SettingsLabelRef.Parent then
				for _, inst in ipairs(RootFrame:GetDescendants()) do
					if inst:IsA("TextButton") then
						local label = inst:FindFirstChildWhichIsA("TextLabel", true)
						if label and label.Text == "Settings" then
							SettingsLabelRef = label
							SettingsButtonRef = inst
							Track(SettingsLabelRef:GetPropertyChangedSignal("TextColor3"):Connect(UpdateColors))
							break
						end
					end
				end
			end

			if not GradientRef or not GradientRef.Parent then
				for _, inst in ipairs(RootFrame:GetDescendants()) do
					if inst:IsA("UIGradient") then 
						GradientRef = inst 
						Track(GradientRef:GetPropertyChangedSignal("Color"):Connect(UpdateColors))
						break 
					end
				end
			end

			local TargetBgColor = Color3.fromRGB(30, 30, 30)

			local currentTheme = Library.Theme and Library.Themes and Library.Themes[Library.Theme]
			if currentTheme then
				local directFont = currentTheme.FontColor or currentTheme.TextColor or currentTheme.Text
				if typeof(directFont) == "Color3" then
					TargetTextColor = directFont
				end
			elseif SettingsLabelRef then 
				TargetTextColor = SettingsLabelRef.TextColor3 
			end

			if SettingsButtonRef then
				TargetBgColor = SettingsButtonRef.BackgroundColor3
			end

			local brightness = (TargetTextColor.R + TargetTextColor.G + TargetTextColor.B) / 3
			local isDarkTheme = (brightness > 0.5)
			local SubColor = isDarkTheme and Color3.fromRGB(160, 160, 160) or Color3.fromRGB(110, 110, 110)

			local stroke = RootFrame:FindFirstChild("UIStroke")
			CurrentFlashColor = stroke and stroke.Color or SubColor

			SearchText.TextColor3 = TargetTextColor
			SearchIcon.ImageColor3 = TargetTextColor
			DisplayName.TextColor3 = TargetTextColor
			UserName.TextColor3 = SubColor

			SpotInput.TextColor3 = TargetTextColor
			SpotIcon.ImageColor3 = TargetTextColor
			SpotInput.PlaceholderColor3 = SubColor
			SpotSeparator.BackgroundColor3 = SubColor

			for _, secTitle in ipairs(AllSectionTitles) do
				if secTitle and secTitle.Parent then
					secTitle.TextColor3 = TargetTextColor
					local arrow = secTitle:FindFirstChild("CollapseArrow")
					if arrow then
						arrow.ImageColor3 = TargetTextColor
					end
				end
			end

			if Window.UpdateSectionHighlights then
				Window.UpdateSectionHighlights()
			end

			if DashboardOverlay.Visible then
				local windowBg = (GradientRef and GradientRef.Color and #GradientRef.Color.Keypoints > 0) and GradientRef.Color.Keypoints[1].Value or Color3.fromRGB(15, 20, 28)

				local cardBaseColor = Color3.new(
					math.clamp(windowBg.R * 0.72, 0, 1),
					math.clamp(windowBg.G * 0.72, 0, 1),
					math.clamp(windowBg.B * 0.72, 0, 1)
				)

				local boxFill = Color3.new(
					math.clamp(windowBg.R * 0.48, 0, 1),
					math.clamp(windowBg.G * 0.48, 0, 1),
					math.clamp(windowBg.B * 0.48, 0, 1)
				)

				local boxOutline = stroke and stroke.Color or SubColor

				DashboardCard.BackgroundColor3 = cardBaseColor
				DashTitle.TextColor3 = TargetTextColor
				DashClose.TextColor3 = TargetTextColor
				DashStroke.Color = boxOutline

				for _, item in ipairs(StatCardFrames) do
					item.card.BackgroundColor3 = boxFill
					item.stroke.Color = boxOutline
					item.stroke.Transparency = 0.75
				end

				for _, lbl in ipairs(StatCardTitles) do
					lbl.TextColor3 = TargetTextColor
				end

				for _, val in ipairs(StatCardValues) do
					val.TextColor3 = SubColor
				end
			end

			if GradientRef then
				SpotlightGradient.Color = GradientRef.Color
				SpotlightGradient.Rotation = GradientRef.Rotation
				SpotlightFrame.BackgroundColor3 = Color3.new(1,1,1)
			else
				SpotlightFrame.BackgroundColor3 = TargetBgColor
			end

			if stroke then
				SearchStroke.Color = stroke.Color
				AvatarStroke.Color = stroke.Color
				SpotlightStroke.Color = stroke.Color
				DashStroke.Color = stroke.Color
			else
				SearchStroke.Transparency = 1
			end

			for _, btn in pairs(SpotResults:GetChildren()) do
				if btn:IsA("TextButton") then
					local t = btn:FindFirstChild("Title")
					if t then t.TextColor3 = TargetTextColor end
					local dot = btn:FindFirstChild("Dot")
					if dot then dot.TextColor3 = TargetTextColor end
					local tabL = btn:FindFirstChild("TabLabel")
					if tabL then tabL.TextColor3 = TargetTextColor end
					local icon = btn:FindFirstChild("Icon")
					if icon then icon.ImageColor3 = TargetTextColor end
					local str = btn:FindFirstChild("UIStroke")
					if str and btn:GetAttribute("Hovering") then str.Color = TargetTextColor end
				end
			end
		end)
